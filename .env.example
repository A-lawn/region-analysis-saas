# ==========================================
# 区域数据分析平台 v3.0 — 环境变量配置
# 复制此文件为 .env 并填入实际值
# ==========================================

# ---- 服务器 ----
PORT=3000
NODE_ENV=production
APP_URL=http://localhost:8080

# ---- 数据库 ----
DB_PASSWORD=postgres

# ---- JWT 认证 (v3.0 信封加密) ----
# ENC_KEY: AES-256-GCM 信封加密主密钥（32字节base64）
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENC_KEY=<生成base64随机串>

# JWT_SECRET: 兼容旧token + Express↔Python内部通信签名
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<生成64位hex字符串>

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- 缓存 ----
CACHE_TTL=3600

# ---- SMTP 邮件 ----
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=your@email.com
SMTP_PASS=your_smtp_password
SMTP_FROM_EMAIL=your@email.com
SMTP_FROM_NAME=区域数据分析平台

# ---- 高德地图 API Key ----
AMAP_WEB_KEY=your_amap_web_key
AMAP_SERVER_KEY=your_amap_server_key

# ---- 文件上传 ----
MAX_FILE_SIZE_MB=50

# ---- 备份 ----
BACKUP_RETENTION_DAYS=180

# ---- Python 计算引擎 (v3.0) ----
PYTHON_COMPUTE_URL=http://python-compute:8000
LOG_LEVEL=INFO

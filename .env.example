# ==========================================
# 区域数据分析平台 v1.0 - 环境变量配置
# 复制此文件为 .env 并填入实际值
# ==========================================

# ---- 服务器 ----
PORT=3000                              # 后端监听端口
NODE_ENV=production                    # 环境: development | production
APP_URL=http://localhost:8080          # 应用访问地址（用于邮件重置链接）

# ---- JWT 认证 ----
JWT_SECRET=<生成随机64位hex字符串>       # JWT签名密钥（必填，启动时校验）

# ---- PostgreSQL + PostGIS ----
DB_HOST=localhost                      # 数据库主机
DB_PORT=5432                           # 数据库端口
DB_NAME=region_analysis                # 数据库名
DB_USER=postgres                       # 数据库用户
DB_PASSWORD=postgres                   # 数据库密码
DB_POOL_MAX=10                         # 连接池大小

# ---- Redis ----
REDIS_HOST=localhost                   # Redis主机
REDIS_PORT=6379                        # Redis端口
CACHE_TTL=3600                         # 分析结果缓存秒数（默认1小时）


# ---- Redis (可选，用于缓存和异步分析) ----
# 从 v1.0 开始 Redis 是必需的（BullMQ 异步分析依赖）
REDIS_HOST=localhost                   # Redis 主机地址
REDIS_PORT=6379                        # Redis 端口
REDIS_PASSWORD=                        # Redis 密码（可选，留空表示无密码）
CACHE_TTL=3600                         # 分析结果缓存秒数（默认 1 小时）

# ---- SMTP 邮件 ----
SMTP_HOST=smtp.163.com                 # SMTP服务器
SMTP_PORT=465                          # SMTP端口（465=SSL, 587=TLS）
SMTP_USER=your@email.com               # SMTP用户名
SMTP_PASS=your_smtp_password           # SMTP密码/授权码
SMTP_FROM_EMAIL=your@email.com         # 发件人邮箱
SMTP_FROM_NAME=区域数据分析平台          # 发件人显示名称

# ---- 高德地图 API Key ----
AMAP_WEB_KEY=your_amap_web_key         # 高德Web端JS API Key
AMAP_SERVER_KEY=your_amap_server_key   # 高德Web服务API Key（地理编码等）

# ---- 文件上传 ----
MAX_FILE_SIZE_MB=50

# ---- 备份 ----
BACKUP_RETENTION_DAYS=180                    # 上传文件大小限制（MB）